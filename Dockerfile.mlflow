FROM python:3.12.16-slim AS builder
COPY --from=ghcr.io/astral-sh/uv:0.12.13 /uv /bin/uv
ENV UV_LINK_MODE=copy UV_PYTHON_DOWNLOADS=never
WORKDIR /app
COPY pyproject.toml uv.lock ./
RUN uv sync --locked --no-dev --extra aws --extra mlflow-server --no-install-project
COPY README.md ./
COPY src ./src
RUN uv sync --locked --no-dev --extra aws --extra mlflow-server --no-editable

FROM python:3.12.16-slim
RUN apt-get update && apt-get upgrade --yes \
    && apt-get install --yes --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd --gid 10001 mlflow && useradd --uid 10001 --gid 10001 --create-home mlflow
COPY --from=builder /app/.venv /app/.venv
ENV PATH="/app/.venv/bin:${PATH}" PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 HOME=/home/mlflow
WORKDIR /home/mlflow
USER 10001:10001
EXPOSE 5000
ENTRYPOINT ["python", "-m", "mlops_sales_forecasting.aws.mlflow_server"]
