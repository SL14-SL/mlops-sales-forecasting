# Application environment
APP_ENV=dev
LOG_LEVEL=INFO

# Local API
API_PORT=8000
API_KEY=replace-with-a-local-development-key

# Local Prefect server
PREFECT_PORT=4200
PREFECT_API_URL=http://localhost:4200/api

# Container image
IMAGE_TAG=local

# Local monitoring
PROMETHEUS_VERSION=v3.5.0
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=15d

GRAFANA_VERSION=12.1.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin

ALERTMANAGER_VERSION=v0.28.1
ALERTMANAGER_PORT=9093

# Streamlit Dashboard
DASHBOARD_PORT=8501

# Optional model-lifecycle webhook
LIFECYCLE_WEBHOOK_URL=